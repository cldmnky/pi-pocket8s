# Build stage. BUILDPLATFORM runs the Go toolchain natively; TARGETOS and
# TARGETARCH select the cross-compiled binary for multi-arch manifests. The toolchain
# comes from Red Hat's registry, not Docker Hub, whose anonymous pull limits have
# failed CI builds. This is the RHEL 10.2 stream, the same Go the runtime image
# installs with `dnf install golang`; it is only ever a build stage.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi10/go-toolset:10.2 AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-$(go env GOARCH)} \
    go build -trimpath -ldflags="-s -w" -o /tmp/out/portal . \
    && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-$(go env GOARCH)} \
       go build -trimpath -ldflags="-s -w" -o /tmp/out/admin-controller ./cmd/admin-controller

# Runtime stage: latest UBI 10 minimal running as non-root UID 1000.
# No credentials, package installs, or writable state are required.
FROM registry.access.redhat.com/ubi10/ubi-minimal:latest
LABEL org.opencontainers.image.title="pi-pocket portal" \
      org.opencontainers.image.description="Runtime configuration and lifecycle portal for pi-pocket" \
      org.opencontainers.image.source="https://github.com/cldmnky/pi-pocket8s"
COPY --from=build /tmp/out/portal /usr/local/bin/portal
# The cluster-admin lifecycle reconciler shares this image and runs with its own
# service account; it exposes only a health endpoint.
COPY --from=build /tmp/out/admin-controller /usr/local/bin/admin-controller
USER 1000:1000
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/portal"]
