# Pi Pocket on UBI 10, with an integrated developer toolchain (Go, Node 24, Python,
# build tools, Podman/Skopeo/Buildah, kubectl/oc/helm, ripgrep, jq, ...).
#
# Build from the repository root (the containerfile clones upstream itself):
#
#   podman build --pull -f images/Containerfile -t pi-pocket .
#
# The upstream source is pinned by commit and its working tree is verified after the
# shallow fetch. See images/README.md for the runtime contract and the CI tag policy.

ARG BASE_IMAGE=registry.access.redhat.com/ubi10/ubi:latest

# ── upstream source, pinned by commit ─────────────────────────────────────────────
FROM ${BASE_IMAGE} AS source

ARG PI_POCKET_REPOSITORY=https://github.com/TannerMidd/pi-pocket.git
ARG PI_POCKET_COMMIT=5e13a8b161226cbfef3e696c1bd31b8da110e381

RUN set -eux; \
    dnf install -y --setopt=install_weak_deps=False git \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum

WORKDIR /src
RUN set -eux; \
    git init -q /src/pi-pocket; \
    cd /src/pi-pocket; \
    git remote add origin "${PI_POCKET_REPOSITORY}"; \
    git fetch -q --depth 1 origin "${PI_POCKET_COMMIT}"; \
    git checkout -q FETCH_HEAD; \
    test "$(git rev-parse HEAD)" = "${PI_POCKET_COMMIT}"; \
    test -f package-lock.json; \
    test -f bin/pi-pocket.js; \
    rm -rf /src/pi-pocket/.git

# ── terminal daemon (Go, static; ghostty-web frontend is vendored) ──
# The Go toolchain comes from Red Hat's registry, not Docker Hub, whose anonymous
# pull limits have failed CI runs. This is the RHEL 10.2 stream, the same Go the
# runtime image installs with `dnf install golang`. Build stage only — nothing from
# it is shipped. Bump the tag with the base image when RHEL moves on.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi10/go-toolset:10.2 AS terminal-build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY terminal/go.mod terminal/go.sum ./
RUN go mod download
COPY terminal/ ./
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-$(go env GOARCH)} \
    go build -trimpath -ldflags="-s -w" -o /tmp/out/pi-terminal .

# ── runtime image ─────────────────────────────────────────────────────────────────
FROM ${BASE_IMAGE}

ARG PI_POCKET_VERSION=0.26.0
ARG PI_POCKET_COMMIT=5e13a8b161226cbfef3e696c1bd31b8da110e381
ARG TARGETARCH

ARG RIPGREP_VERSION=15.2.0
ARG KUBECTL_VERSION=v1.35.6
ARG HELM_VERSION=v4.3.0
ARG OC_VERSION=4.22.17
ARG GH_VERSION=2.102.0
ARG AGENT_BROWSER_VERSION=0.38.2
# Chrome for Testing, pinned Stable. CfT publishes no checksums, so the
# version is pinned exactly and downloads use HTTPS from Google's bucket.
ARG CHROME_VERSION=155.0.8059.39

# Developer tools UBI 10 has no RPM for. yq, actionlint and uv publish a checksum
# file (or one per asset) that the build fetches; shellcheck, fd, bat and delta
# publish none, so their per-asset SHA-256 is pinned here instead — bump the version
# and the matching digests together, or the build stops on sha256sum -c.
ARG YQ_VERSION=4.54.1
ARG SHELLCHECK_VERSION=0.11.0
ARG SHELLCHECK_SHA256_X86_64=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6
ARG SHELLCHECK_SHA256_AARCH64=68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc
ARG ACTIONLINT_VERSION=1.7.12
ARG FD_VERSION=10.5.0
ARG FD_SHA256_X86_64=761c72dc8e120d85b22292063be8a796e2eeb20eb3e4f38b8fa2343ccf3514a7
ARG FD_SHA256_AARCH64=d76c4317f7d5dba69f8a2a15856c90c777e7f0dd4e85f0de8c76de6992c374d4
ARG BAT_VERSION=0.26.1
ARG BAT_SHA256_X86_64=0dcd8ac79732c0d5b136f11f4ee00e581440e16a44eab5b3105b611bbf2cf191
ARG BAT_SHA256_AARCH64=6369242c584065f195fb20cb36fbd7cb63ae690605bbe89868a7596b596c2c23
ARG DELTA_VERSION=0.20.1
ARG DELTA_SHA256_X86_64=50f08c879f84c81ceb220e476491a7f492d2c9c671e79918cc44badf961a6240
ARG DELTA_SHA256_AARCH64=da7f4338f593572ff426ae153e0870e2fdc72729416eff551b40cdeb67940db8
ARG UV_VERSION=0.13.6

LABEL \
    name="pi-pocket" \
    vendor="cldmnky" \
    version="${PI_POCKET_VERSION}" \
    summary="Pi Pocket with an integrated RHEL 10 developer toolchain" \
    description="Durable, multiplayer web app for Pi agents (upstream pi-pocket ${PI_POCKET_VERSION}, commit ${PI_POCKET_COMMIT}) on UBI 10, running as UID/GID 1000 with a persistent /workspace/home." \
    io.k8s.display-name="Pi Pocket" \
    io.k8s.description="Pi Pocket and its agents' toolchain (Node 24, Go, Python, C/C++/cmake, git/ssh, podman/buildah/skopeo, kubectl/oc/helm, headless Chromium)." \
    io.openshift.tags="pi-pocket,ai,devtools" \
    io.openshift.expose-services="8787:http" \
    org.opencontainers.image.title="pi-pocket" \
    org.opencontainers.image.description="Pi Pocket on UBI 10 with an integrated developer toolchain" \
    org.opencontainers.image.source="https://github.com/cldmnky/pi-pocket8s" \
    org.opencontainers.image.url="https://github.com/TannerMidd/pi-pocket" \
    org.opencontainers.image.version="${PI_POCKET_VERSION}" \
    org.opencontainers.image.revision="${PI_POCKET_COMMIT}" \
    org.opencontainers.image.licenses="MIT"

# RHEL 10 ships Node.js 24 as versioned binaries (node-24, npm-24, npx-24); Node's own
# tools and the upstream launcher expect plain names on PATH.
# Chromium runtime libraries (for chrome-headless-shell below): all from UBI
# repos, verified on both arches. EPEL chromium is intentionally NOT used:
# it requires libpipewire, which no UBI 10 container repo provides.
RUN set -eux; \
    dnf install -y --setopt=install_weak_deps=False \
        alsa-lib \
        atk \
        at-spi2-atk \
        at-spi2-core \
        cmake \
        curl \
        dejavu-sans-fonts \
        diffutils \
        file \
        fontconfig \
        fuse-overlayfs \
        gcc \
        gcc-c++ \
        git \
        golang \
        jq \
        less \
        libcap \
        libX11 \
        libXcomposite \
        libXdamage \
        libXext \
        libXfixes \
        libXrandr \
        libsndfile \
        libxcb \
        libxkbcommon \
        make \
        mesa-libgbm \
        nmap-ncat \
        nspr \
        nss \
        nodejs24 \
        nodejs24-npm \
        openssh \
        openssh-clients \
        openssl \
        patch \
        pkgconf \
        podman \
        buildah \
        skopeo \
        socat \
        sqlite \
        procps-ng \
        python3-pip \
        python3-devel \
        rsync \
        tar \
        unzip \
        vim-enhanced \
        xz \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum

# `socat`, `sqlite` (the sqlite3 CLI) and `nmap-ncat` (ncat and nc) come from UBI's own
# appstream repo: Red Hat builds and signs them, so they need no download block. The
# sqlite3 binary is for inspecting the workspace's databases; the live `pocket.sqlite`
# is read-only from a shell, because the app is its single writer.
RUN set -eux; \
    sqlite3 :memory: 'select 1'; \
    sqlite3 --version; \
    ncat --version; \
    test -x /usr/bin/nc; \
    socat -V

RUN set -eux; \
    ln -sf /usr/bin/node-24 /usr/local/bin/node; \
    ln -sf /usr/bin/npm-24 /usr/local/bin/npm; \
    ln -sf /usr/bin/npx-24 /usr/local/bin/npx; \
    node --version; \
    npm --version; \
    node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 19)) { throw new Error("Pi Pocket needs Node.js 22.19 or newer, found " + process.versions.node); }'

# Tools that UBI has no RPM for. Every download is checked against the vendor's
# published SHA-256 before it is installed. OpenShift publishes the amd64 oc client
# only as rhel8/rhel9 builds; the rhel9 build of each architecture runs on RHEL 10.
RUN set -eux; \
    case "${TARGETARCH:-$(uname -m)}" in \
        amd64|x86_64) rg_arch=x86_64; kube_arch=amd64; helm_arch=amd64; oc_arch=amd64; chrome_arch=linux64 ;; \
        arm64|aarch64) rg_arch=aarch64; kube_arch=arm64; helm_arch=arm64; oc_arch=arm64; chrome_arch=linux-arm64 ;; \
        *) echo "unsupported architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
    esac; \
    downloads=/tmp/downloads; \
    mkdir -p "${downloads}"; \
    cd "${downloads}"; \
    rg_tar="ripgrep-${RIPGREP_VERSION}-${rg_arch}-unknown-linux-musl.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/BurntSushi/ripgrep/releases/download/${RIPGREP_VERSION}/${rg_tar}"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/BurntSushi/ripgrep/releases/download/${RIPGREP_VERSION}/${rg_tar}.sha256"; \
    sha256sum -c "${rg_tar}.sha256"; \
    tar -xzf "${rg_tar}" --strip-components=1 -C /usr/local/bin "ripgrep-${RIPGREP_VERSION}-${rg_arch}-unknown-linux-musl/rg"; \
    curl -fsSL --retry 5 --retry-delay 2 -o kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${kube_arch}/kubectl"; \
    curl -fsSL --retry 5 --retry-delay 2 -o kubectl.sha256 "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${kube_arch}/kubectl.sha256"; \
    echo "$(cat kubectl.sha256)  kubectl" | sha256sum -c -; \
    install -m 0755 kubectl /usr/local/bin/kubectl; \
    helm_tar="helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://get.helm.sh/${helm_tar}"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://get.helm.sh/${helm_tar}.sha256sum"; \
    sha256sum -c "${helm_tar}.sha256sum"; \
    tar -xzf "${helm_tar}" "linux-${helm_arch}/helm"; \
    install -m 0755 "linux-${helm_arch}/helm" /usr/local/bin/helm; \
    oc_tar="openshift-client-linux-${oc_arch}-rhel9-${OC_VERSION}.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OC_VERSION}/${oc_tar}"; \
    curl -fsSL --retry 5 --retry-delay 2 -o sha256sum.txt "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OC_VERSION}/sha256sum.txt"; \
    grep " ${oc_tar}\$" sha256sum.txt | sha256sum -c -; \
    tar -xzf "${oc_tar}" oc; \
    install -m 0755 oc /usr/local/bin/oc; \
    gh_tar="gh_${GH_VERSION}_linux_${kube_arch}.tar.gz"; \
    curl -fsSL --retry 5 -O "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${gh_tar}"; \
    curl -fsSL --retry 5 -o gh-checksums.txt "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_checksums.txt"; \
    grep " ${gh_tar}\$" gh-checksums.txt | sha256sum -c -; \
    tar -xzf "${gh_tar}"; \
    mkdir -p /usr/local/libexec; \
    install -m 0755 "gh_${GH_VERSION}_linux_${kube_arch}/bin/gh" /usr/local/libexec/gh; \
    /usr/local/libexec/gh --version; \
    curl -fsSL --retry 5 --retry-delay 2 -o chrome-headless-shell.zip "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VERSION}/${chrome_arch}/chrome-headless-shell-${chrome_arch}.zip"; \
    unzip -q chrome-headless-shell.zip -d /opt; \
    ln -sf "/opt/chrome-headless-shell-${chrome_arch}/chrome-headless-shell" /usr/local/bin/chromium; \
    chromium --version; \
    rg --version; \
    kubectl version --client; \
    helm version; \
    oc version --client; \
    cd /; \
    rm -rf "${downloads}"

# The linters and the YAML/JSON tool, in their own layer so bumping one does not re-fetch
# the browser and kubectl above. yq reads and edits manifests from the shell; shellcheck
# and actionlint are the checks this repository runs on its own scripts and workflows, so
# they are in the image for an agent to run before it pushes; fd is find with sane
# defaults. Same contract as the block above: each archive is verified before anything
# from it is installed.
RUN set -eux; \
    case "${TARGETARCH:-$(uname -m)}" in \
        amd64|x86_64) yq_arch=amd64; actionlint_arch=amd64; sc_arch=x86_64; sc_sha="${SHELLCHECK_SHA256_X86_64}"; fd_arch=x86_64; fd_sha="${FD_SHA256_X86_64}" ;; \
        arm64|aarch64) yq_arch=arm64; actionlint_arch=arm64; sc_arch=aarch64; sc_sha="${SHELLCHECK_SHA256_AARCH64}"; fd_arch=aarch64; fd_sha="${FD_SHA256_AARCH64}" ;; \
        *) echo "unsupported architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
    esac; \
    downloads=/tmp/downloads-lint; \
    mkdir -p "${downloads}"; \
    cd "${downloads}"; \
    yq_tar="yq_linux_${yq_arch}.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/${yq_tar}"; \
    curl -fsSL --retry 5 --retry-delay 2 -o yq-checksums-bsd "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/checksums-bsd"; \
    yq_line="$(grep -F "SHA256 (${yq_tar}) = " yq-checksums-bsd)"; \
    test -n "${yq_line}"; \
    echo "$(printf '%s\n' "${yq_line}" | cut -d' ' -f4)  ${yq_tar}" | sha256sum -c -; \
    tar -xzf "${yq_tar}" "./yq_linux_${yq_arch}"; \
    install -m 0755 "./yq_linux_${yq_arch}" /usr/local/bin/yq; \
    sc_tar="shellcheck-v${SHELLCHECK_VERSION}.linux.${sc_arch}.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/koalaman/shellcheck/releases/download/v${SHELLCHECK_VERSION}/${sc_tar}"; \
    echo "${sc_sha}  ${sc_tar}" | sha256sum -c -; \
    tar -xzf "${sc_tar}" "shellcheck-v${SHELLCHECK_VERSION}/shellcheck"; \
    install -m 0755 "shellcheck-v${SHELLCHECK_VERSION}/shellcheck" /usr/local/bin/shellcheck; \
    actionlint_tar="actionlint_${ACTIONLINT_VERSION}_linux_${actionlint_arch}.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/${actionlint_tar}"; \
    curl -fsSL --retry 5 --retry-delay 2 -o actionlint-checksums.txt "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_checksums.txt"; \
    grep " ${actionlint_tar}\$" actionlint-checksums.txt | sha256sum -c -; \
    tar -xzf "${actionlint_tar}" actionlint; \
    install -m 0755 actionlint /usr/local/bin/actionlint; \
    fd_tar="fd-v${FD_VERSION}-${fd_arch}-unknown-linux-musl.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/${fd_tar}"; \
    echo "${fd_sha}  ${fd_tar}" | sha256sum -c -; \
    tar -xzf "${fd_tar}" "fd-v${FD_VERSION}-${fd_arch}-unknown-linux-musl/fd"; \
    install -m 0755 "fd-v${FD_VERSION}-${fd_arch}-unknown-linux-musl/fd" /usr/local/bin/fd; \
    yq --version; \
    shellcheck --version; \
    actionlint --version; \
    fd --version; \
    cd /; \
    rm -rf "${downloads}"

# The highlighter, the diff viewer and the Python toolchain, again in their own layer. bat
# and delta make a diff or a log readable for a human reading along, delta as an opt-in
# per-user Git pager (the image sets no core.pager); uv and uvx are the modern Python
# environment and tool runner, beside the RHEL python3/pip above. delta's release tag has
# no `v` prefix and publishes no aarch64-musl asset, so both architectures take its gnu
# build; uv publishes a checksum next to each asset, bat and delta none, so their digests
# are the pinned ones above.
RUN set -eux; \
    case "${TARGETARCH:-$(uname -m)}" in \
        amd64|x86_64) bat_arch=x86_64; bat_sha="${BAT_SHA256_X86_64}"; delta_arch=x86_64; delta_sha="${DELTA_SHA256_X86_64}"; uv_arch=x86_64 ;; \
        arm64|aarch64) bat_arch=aarch64; bat_sha="${BAT_SHA256_AARCH64}"; delta_arch=aarch64; delta_sha="${DELTA_SHA256_AARCH64}"; uv_arch=aarch64 ;; \
        *) echo "unsupported architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
    esac; \
    downloads=/tmp/downloads-pager; \
    mkdir -p "${downloads}"; \
    cd "${downloads}"; \
    bat_tar="bat-v${BAT_VERSION}-${bat_arch}-unknown-linux-musl.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/sharkdp/bat/releases/download/v${BAT_VERSION}/${bat_tar}"; \
    echo "${bat_sha}  ${bat_tar}" | sha256sum -c -; \
    tar -xzf "${bat_tar}" "bat-v${BAT_VERSION}-${bat_arch}-unknown-linux-musl/bat"; \
    install -m 0755 "bat-v${BAT_VERSION}-${bat_arch}-unknown-linux-musl/bat" /usr/local/bin/bat; \
    delta_tar="delta-${DELTA_VERSION}-${delta_arch}-unknown-linux-gnu.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/${delta_tar}"; \
    echo "${delta_sha}  ${delta_tar}" | sha256sum -c -; \
    tar -xzf "${delta_tar}" "delta-${DELTA_VERSION}-${delta_arch}-unknown-linux-gnu/delta"; \
    install -m 0755 "delta-${DELTA_VERSION}-${delta_arch}-unknown-linux-gnu/delta" /usr/local/bin/delta; \
    uv_tar="uv-${uv_arch}-unknown-linux-gnu.tar.gz"; \
    curl -fsSL --retry 5 --retry-delay 2 -O "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/${uv_tar}"; \
    curl -fsSL --retry 5 --retry-delay 2 -o "${uv_tar}.sha256" "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/${uv_tar}.sha256"; \
    sha256sum -c "${uv_tar}.sha256"; \
    tar -xzf "${uv_tar}" "uv-${uv_arch}-unknown-linux-gnu/uv" "uv-${uv_arch}-unknown-linux-gnu/uvx"; \
    install -m 0755 "uv-${uv_arch}-unknown-linux-gnu/uv" /usr/local/bin/uv; \
    install -m 0755 "uv-${uv_arch}-unknown-linux-gnu/uvx" /usr/local/bin/uvx; \
    bat --version; \
    delta --version; \
    uv --version; \
    uvx --version; \
    cd /; \
    rm -rf "${downloads}"

# UID/GID 1000 ("pocket") is fixed so the pod can run with runAsNonRoot and
# runAsUser: 1000. The nested-container profile adds SETUID/SETGID and
# allowPrivilegeEscalation so the setuid/filecap helpers below can build nested user
# namespaces. The subordinate range stays inside the pod's outer 65536-uid mapping
# (hostUsers: false), which is what newuidmap/newgidmap can map there.
RUN set -eux; \
    groupadd --gid 1000 pocket; \
    useradd --uid 1000 --gid 1000 --no-create-home --home-dir /workspace/home --shell /bin/bash pocket; \
    touch /etc/subuid /etc/subgid; \
    sed -i '/^pocket:/d' /etc/subuid /etc/subgid; \
    echo 'pocket:10000:50000' >> /etc/subuid; \
    echo 'pocket:10000:50000' >> /etc/subgid; \
    for helper in newuidmap newgidmap; do \
        if [ ! -u "/usr/bin/${helper}" ] && ! getcap "/usr/bin/${helper}" | grep -q 'cap_'; then \
            setcap cap_setuid,cap_setgid+ep "/usr/bin/${helper}"; \
        fi; \
        if [ ! -u "/usr/bin/${helper}" ] && ! getcap "/usr/bin/${helper}" | grep -q 'cap_'; then \
            echo "${helper} needs setuid or file capabilities for rootless containers" >&2; \
            exit 1; \
        fi; \
    done; \
    getcap /usr/bin/newuidmap /usr/bin/newgidmap; \
    mkdir -p /workspace/home /workspace/repos /run/pocket-config /opt/pi-pocket; \
    chown 1000:1000 /workspace/home /workspace/repos; \
    chmod 0755 /run/pocket-config; \
    printf '# Managed by the pi-pocket image.\n# vfs keeps rootless Podman and Buildah working without /dev/fuse or host\n# devices; override with STORAGE_DRIVER when the platform allows overlay+fuse.\n\n[storage]\ndriver = "vfs"\n' > /etc/containers/storage.conf; \
    grep -q '^driver = "vfs"$' /etc/containers/storage.conf; \
    git config --system --add safe.directory '*'

COPY --from=source /src/pi-pocket /opt/pi-pocket

# npm ci uses the lockfile committed upstream, including its dev dependencies, so the
# app can run `npm run check` and `npm test` inside the image while agents edit it.
RUN set -eux; \
    cd /opt/pi-pocket; \
    test "$(node -p 'require("./package.json").version')" = "${PI_POCKET_VERSION}"; \
    npm ci --no-audit --no-fund; \
    rm -rf /root/.npm; \
    node --disable-warning=ExperimentalWarning --check bin/pi-pocket.js; \
    test -x node_modules/.bin/pi; \
    test -d node_modules/jiti; \
    chown -R 1000:1000 /opt/pi-pocket

# Agent web search and URL reading: shipped as a Pi Pocket built-in extension, so it loads from
# the application's own extensions folder (visible in Menu → Extensions, where the owner can
# also turn it off). The module file and its helper folder keep their repository names, so
# nothing is rewritten on the way in; the loader finds any top-level *.ts it was not given
# an order for. Searches run on a provider the install already has credentials for, and are
# billable model calls; web_fetch is a plain HTTP read and costs nothing: see
# extensions/web-search/README.md.
COPY --chown=1000:1000 extensions/web-search.ts /opt/pi-pocket/src/server/extensions/web-search.ts
COPY --chown=1000:1000 extensions/web-search/ /opt/pi-pocket/src/server/extensions/web-search/

# Preconfigured subagent types: shipped as a second Pi Pocket built-in extension, so a fresh
# workspace can hand work to an architect, a coder, and an independent reviewer without any
# setup. The type definitions are data, not code: the image keeps its copies beside the shipped
# skill and prompt template, and the entrypoint seeds the ones that are missing into
# ~/.pi/agent/agents/ — the editable copy the agent reads. See
# extensions/agent-types/_readme.md for the format and the workflow.
COPY --chown=1000:1000 extensions/agent-types.ts /opt/pi-pocket/src/server/extensions/agent-types.ts
COPY --chown=1000:1000 extensions/_agent-types-policy.ts /opt/pi-pocket/src/server/extensions/_agent-types-policy.ts
COPY --chown=1000:1000 extensions/agent-types-runtime.test.mjs /tmp/agent-types-runtime.test.mjs
COPY --chown=1000:1000 extensions/agent-types/ /usr/share/pi-agent/agents/

# Fail the build if the extension stops loading, stops installing its wrap, or if a shipped
# type definition loses its frontmatter. `node` runs the TypeScript as it is.
RUN set -eux; \
    cd /opt/pi-pocket; \
    test -f /usr/share/pi-agent/agents/architect.md; \
    test -f /usr/share/pi-agent/agents/coder.md; \
    test -f /usr/share/pi-agent/agents/reviewer.md; \
    node --input-type=module -e ' \
        const { readdirSync, readFileSync } = await import("node:fs"); \
        const { default: createAgentTypes } = await import("/opt/pi-pocket/src/server/extensions/agent-types.ts"); \
        const extension = createAgentTypes({ notice() {}, agentDir: "/usr/share/pi-agent" }); \
        if (extension.name !== "agent-types") throw new Error("unexpected extension name: " + extension.name); \
        if (extension.wraps?.length !== 2) throw new Error("expected a tool wrap and a section wrap, got " + (extension.wraps?.length ?? 0)); \
        for (const file of readdirSync("/usr/share/pi-agent/agents").filter((each) => each.endsWith(".md") && !each.startsWith("_"))) { \
            const text = readFileSync("/usr/share/pi-agent/agents/" + file, "utf8"); \
            const block = /^---\n([\s\S]*?)\n---\n/.exec(text); \
            if (block === null) throw new Error(file + " has no frontmatter"); \
            for (const key of ["model", "thinking", "tools", "description"]) { \
                if (!new RegExp("^" + key + ": ", "m").test(block[1])) throw new Error(file + " is missing " + key); \
            } \
        } \
        console.log("agent-types extension ok"); \
    '

# The project-trust wiring needs the real trust store and settings manager. Run the test against the copy above;
# it is not part of the image once the check is done.
RUN set -eux; \
    cd /opt/pi-pocket; \
    AGENT_TYPES_MODULE=/opt/pi-pocket/src/server/extensions/agent-types.ts \
        node --test /tmp/agent-types-runtime.test.mjs; \
    rm -f /tmp/agent-types-runtime.test.mjs

# Fail the build if the extension stops loading or stops installing its tools. `node` runs the
# TypeScript as it is; the module imports only what the image already has.
RUN set -eux; \
    cd /opt/pi-pocket; \
    test -f src/server/extensions/web-search/vendor/providers/openai.ts; \
    test -f src/server/extensions/web-search/fetch.ts; \
    node --input-type=module -e ' \
        const { default: createWebSearch } = await import("/opt/pi-pocket/src/server/extensions/web-search.ts"); \
        const extension = createWebSearch({ notice() {} }); \
        if (extension.name !== "pocket-web-search") throw new Error("unexpected extension name: " + extension.name); \
        if (extension.tools?.[0]?.name !== "web_search") throw new Error("the web_search tool was not installed"); \
        if (!extension.tools?.some((tool) => tool.name === "web_fetch")) throw new Error("the web_fetch tool was not installed"); \
        console.log("web-search extension ok:", extension.tools.map((tool) => tool.name).join(",")); \
    '

# The three tools the module installs, called for real: a result must carry its parts in `output`, which is API 2
# (Pi Durable renamed it from `content`), and Pi Pocket's old-name shim covers drop-ins only. Only a loopback server
# is on the network, and nothing is signed in, so this costs nothing and can run in the build.
COPY --chown=1000:1000 extensions/web-search-runtime.test.mjs /tmp/web-search-runtime.test.mjs
RUN set -eux; \
    cd /opt/pi-pocket; \
    WEB_SEARCH_MODULE=/opt/pi-pocket/src/server/extensions/web-search.ts \
        node --test /tmp/web-search-runtime.test.mjs; \
    rm -f /tmp/web-search-runtime.test.mjs

# agent-browser: Rust browser-automation CLI for agents, driving the
# headless-shell Chromium above over CDP (snapshots, clicks, forms,
# screenshots, auth vault). Version-matched usage instructions ship with the
# CLI itself (`agent-browser skills get core`), so nothing is vendored. The npm
# tarball bundles every platform binary, so prune all but the build-arch glibc
# one (npm verifies the tarball integrity on install). `agent-browser install`
# is deliberately skipped: it would download a second browser, while
# AGENT_BROWSER_EXECUTABLE_PATH (see ENV) points at the Chromium already here.
RUN set -eux; \
    npm install -g --no-audit --no-fund "agent-browser@${AGENT_BROWSER_VERSION}"; \
    rm -rf /root/.npm; \
    pkgdir="$(npm prefix -g)/lib/node_modules/agent-browser/bin"; \
    case "${TARGETARCH:-$(uname -m)}" in \
        amd64|x86_64) keep=agent-browser-linux-x64 ;; \
        arm64|aarch64) keep=agent-browser-linux-arm64 ;; \
        *) echo "unsupported architecture: ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
    esac; \
    find "${pkgdir}" -maxdepth 1 -name 'agent-browser-*' ! -name "${keep}" ! -name 'agent-browser.js' -delete; \
    test -x "${pkgdir}/${keep}"; \
    agent-browser --version

COPY images/github-credentials.mjs /usr/local/bin/gh
RUN chmod 0755 /usr/local/bin/gh
COPY pi-agent/ /usr/share/pi-agent/
# Fail the build if the shipped model fix loses its shape: Pi reads models.json once, at startup, and
# a broken file is ignored silently, which would put kimi-k3 back to failing every tool-using request.
RUN set -eux; \
    test -f /usr/share/pi-agent/models.json; \
    node -e ' \
        const fix = require("/usr/share/pi-agent/models.json"); \
        const entry = fix.providers?.["opencode-go"]?.modelOverrides?.["kimi-k3"]; \
        if (entry?.compat?.supportsStrictMode !== false) throw new Error("the kimi-k3 strict-mode override is missing"); \
        console.log("model fix ok"); \
    '

# The pin, checked in the application itself rather than in the Containerfile: the checkout's version, the Pi
# packages the shipped extensions are written against, the extension API level the app loads, and the kimi-k3
# override as Pi resolves it from this very file. The entrypoint seeds the same file into the workspace home.
COPY --chown=1000:1000 images/pocket-runtime-compat.test.mjs /tmp/pocket-runtime-compat.test.mjs
RUN set -eux; \
    cd /opt/pi-pocket; \
    POCKET_APP_DIR=/opt/pi-pocket POCKET_MODELS_JSON=/usr/share/pi-agent/models.json \
        node --test /tmp/pocket-runtime-compat.test.mjs; \
    rm -f /tmp/pocket-runtime-compat.test.mjs
COPY --from=terminal-build /tmp/out/pi-terminal /usr/local/bin/pi-terminal
RUN chmod 0755 /usr/local/bin/pi-terminal
COPY images/entrypoint.sh /usr/local/bin/pi-pocket-entrypoint
COPY images/embed-patch.sh /usr/local/bin/pi-pocket-embed-patch
COPY images/log-filter.mjs /usr/local/bin/pi-pocket-log-filter
RUN chmod 0755 /usr/local/bin/pi-pocket-entrypoint /usr/local/bin/pi-pocket-embed-patch /usr/local/bin/pi-pocket-log-filter

